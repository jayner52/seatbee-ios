<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces-Variable.ttf</string>
		<string>Inter-Variable.ttf</string>
		<string>RalewayDots-Regular.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>seatbee</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.seatbee.app</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required by Apple App Store 5.1.1 for any code path that
	     writes to the user's photo library. We use this when a guest
	     saves their personal QR code from the Share screen. Without
	     a usage description, the OS hard-crashes on first save call. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save your event's QR code or floor plan to your photo library so you can text it, print it, or attach it to invites.</string>
	<!-- Onboarding lets users pick a floor-plan image from their
	     library to trace their venue outline. Photos picker (PHPicker)
	     doesn't strictly require this on iOS 14+, but we declare it so
	     review never flags it during a permission audit. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a floor-plan photo from your library so you can trace your venue's outline on the canvas.</string>
</dict>
</plist>
